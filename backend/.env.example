# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/foundic_db?sslmode=disable"
DIRECT_URL="postgresql://user:password@localhost:5432/foundic_db?sslmode=disable"

# JWT Authentication
JWT_ACCESS_SECRET=your-strong-access-secret-key-foundic-execution-os
JWT_REFRESH_SECRET=your-strong-refresh-secret-key-foundic-execution-os
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Redis / Queue Configuration (Upstash / local Redis)
REDIS_URL="redis://127.0.0.1:6379"

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_USER=example@foundic.com
SMTP_PASS=app-specific-password
